# Copy to env.production on the server (never commit the real file).
APP_URL=https://gutentype.app/
COOKIE_DOMAIN=gutentype.app
COOKIE_SECURE=true
MAIL_DOMAIN=
MAIL_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gutentype
# Off by default; set to true to bring back Keybr's multiplayer or high scores (ISC-50).
GUTENTYPE_MULTIPLAYER=false
GUTENTYPE_HIGHSCORES=false
# Salt for the sign-in rate-limit hashes (ISC-58).
GUTENTYPE_HASH_SALT=
