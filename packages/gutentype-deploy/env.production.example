# Copy to env.production on the server (never commit the real file).
APP_URL=https://gutentype.app/
COOKIE_DOMAIN=gutentype.app
COOKIE_SECURE=true
MAIL_DOMAIN=
MAIL_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gutentype
# Off by default; set to true to bring back Keybr's multiplayer or high scores (ISC-50).
GUTENTYPE_MULTIPLAYER=false
GUTENTYPE_HIGHSCORES=false
# Salt for the sign-in rate-limit hashes (ISC-58). Optional: when empty, a random salt is created once and kept at
# /data/gutentype/hash-salt, shared by every worker.
GUTENTYPE_HASH_SALT=
# The rate limit trusts CF-Connecting-IP, so the origin must accept traffic from Cloudflare only.
# Google sign-in (ISC-21). The OAuth client is created in Google Cloud for the real domain; empty turns Google off.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
