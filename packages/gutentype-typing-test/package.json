{
  "private": true,
  "name": "@gutentype/typing-test",
  "version": "0.0.0",
  "type": "module",
  "description": "Gutentype's Typing Test text: scripture passages swapped into Keybr's typing test (ISC-73).",
  "main": "lib/index.ts",
  "types": ".types/index.d.ts",
  "dependencies": {
    "@gutentype/content": "*",
    "@keybr/content": "*",
    "@keybr/intl": "*",
    "@keybr/lang": "*",
    "@keybr/page-typing-test": "*",
    "@keybr/rand": "*",
    "@keybr/settings": "*",
    "@keybr/textinput": "*",
    "@keybr/widget": "*"
  },
  "devDependencies": {},
  "scripts": {
    "clean": "rm -fr .types",
    "compile": "tsc",
    "test": "tstest --import=@keybr/test-env-browser --import=@keybr/test-env-bundler --test 'lib/**/*.test.{ts,tsx}'"
  }
}
